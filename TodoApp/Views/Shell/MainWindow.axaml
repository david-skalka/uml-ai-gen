<shadui:Window xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
               xmlns:vm="using:TodoApp.ViewModels.Shell"
               x:Class="TodoApp.Views.Shell.MainWindow"
               x:DataType="vm:MainWindowViewModel"
               Title="Todo App"
               Width="1200"
               Height="800"
               TitleFontWeight="SemiBold">

  <shadui:Window.Hosts>
    <shadui:DialogHost Manager="{Binding DialogManager}" />
  </shadui:Window.Hosts>

  <Grid ColumnDefinitions="Auto, *">
    <shadui:Sidebar Grid.Column="0"
                    Width="220"
                    Expanded="True"
                    CurrentRoute="{Binding CurrentRoute}"
                    BorderBrush="{DynamicResource BorderColor30}"
                    BorderThickness="0,0,1,0"
                    Padding="12,16">
      <shadui:Sidebar.Header>
        <TextBlock Classes="h4"
                   Text="Todo App" />
      </shadui:Sidebar.Header>

      <StackPanel Spacing="4">
        <shadui:SidebarItemLabel Text="Pages" />
        <shadui:SidebarItem Content="Todo List"
                            Route="todo-list"
                            Command="{Binding NavigateTodoListCommand}" />
        <shadui:SidebarItem Content="Alarm"
                            Route="alarm"
                            Command="{Binding NavigateAlarmCommand}" />
      </StackPanel>
    </shadui:Sidebar>

    <ContentControl Grid.Column="1"
                    Margin="24"
                    Content="{Binding CurrentPage}" />
  </Grid>
</shadui:Window>
