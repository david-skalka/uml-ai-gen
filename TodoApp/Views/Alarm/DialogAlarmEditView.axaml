<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TodoApp.ViewModels.Alarm"
             xmlns:components="using:TodoApp.Views.Components"
             x:Class="TodoApp.Views.Alarm.DialogAlarmEditView"
             x:DataType="vm:DialogAlarmEditViewModel"
             Background="Transparent"
             MinWidth="520">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto"
          RowSpacing="16">

        <TextBox x:Name="TitleTextBox"
                 x:FieldModifier="public"
                 Grid.Row="1"
                 Watermark="Title"
                 Text="{Binding AlarmTitle}" />

        <TextBox x:Name="TimeTextBox"
                 x:FieldModifier="public"
                 Grid.Row="2"
                 Watermark="Time (yyyy-MM-dd HH:mm)"
                 Text="{Binding Time}" />

        <components:ValidationErrorsView Grid.Row="3"
                                         Text="{Binding ValidationErrors}" />

        <Grid Grid.Row="4"
              ColumnDefinitions="*, Auto, Auto"
              ColumnSpacing="12">
            <Button Grid.Column="1"
                    Classes="Outline"
                    Content="Cancel"
                    Command="{Binding CancelCommand}" />
            <Button x:Name="SaveButton"
                    x:FieldModifier="public"
                    Grid.Column="2"
                    Classes="AccentButton"
                    Content="Save"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</UserControl>
