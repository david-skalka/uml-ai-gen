<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:TodoApp.ViewModels.TodoList"
             xmlns:components="using:TodoApp.Views.Components"
             x:Class="TodoApp.Views.TodoList.DialogTodoListEditView"
             x:DataType="vm:DialogTodoListEditViewModel"
             Background="Transparent"
             MinWidth="520">

  <Grid RowDefinitions="Auto, Auto, Auto, Auto"
        RowSpacing="16"
        Classes="Dialog">
    <TextBlock Grid.Row="0"
               Text="Todo list"
               FontSize="18"
               FontWeight="SemiBold" />

    <u:Form Grid.Row="1"
            LabelPosition="Top"
            LabelWidth="*">
      <u:FormItem Label="Name">
        <TextBox x:Name="NameTextBox"
                 x:FieldModifier="public"
                 Text="{Binding Name}" />
      </u:FormItem>
      <u:FormItem Label="Description">
        <TextBox x:Name="DescriptionTextBox"
                 x:FieldModifier="public"
                 AcceptsReturn="True"
                 MinHeight="100"
                 Text="{Binding Description}" />
      </u:FormItem>
    </u:Form>

    <components:ValidationErrorsView Grid.Row="2"
                                     Text="{Binding ValidationErrors}" />

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                Spacing="12"
                HorizontalAlignment="Right">
      <Button Classes="Tertiary"
              Content="Cancel"
              Command="{Binding CancelCommand}" />
      <Button x:Name="SaveButton"
              x:FieldModifier="public"
              Classes="Primary"
              Content="Save"
              Command="{Binding SaveCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
