<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TodoApp.ViewModels.TodoList"
             x:Class="TodoApp.Views.TodoList.TodoListPageView"
             x:Name="TodoListPage"
             x:DataType="vm:TodoListPageViewModel">

    <TabControl Classes="fb-tabs"
                Margin="16">
        <TabItem Header="CRUD">
            <Border Classes="fb-card"
                    Padding="16"
                    Margin="0,12,0,0">
                <Grid RowDefinitions="80, *"
                      RowSpacing="12">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="Auto, Auto, Auto, Auto"
                          ColumnSpacing="8"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top">
                        <Button x:Name="RefreshButton"
                                x:FieldModifier="public"
                                Grid.Column="0"
                                Classes="Outline"
                                Content="Refresh"
                                Command="{Binding LoadCommand}" />
                        <Button x:Name="NewButton"
                                x:FieldModifier="public"
                                Grid.Column="1"
                                Classes="AccentButton"
                                Content="New"
                                Command="{Binding NewCommand}" />
                        <Button x:Name="EditButton"
                                x:FieldModifier="public"
                                Grid.Column="2"
                                Classes="Outline"
                                Content="Edit"
                                Command="{Binding EditCommand}" />
                        <Button x:Name="DeleteButton"
                                x:FieldModifier="public"
                                Grid.Column="3"
                                Classes="Outline"
                                Content="Delete"
                                Command="{Binding DeleteCommand}" />
                    </Grid>

                    <DataGrid x:Name="TodoListsGrid"
                              x:FieldModifier="public"
                              Grid.Row="1"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              IsReadOnly="True"
                              MinHeight="500">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                            <DataGridCheckBoxColumn Header="Archived" Binding="{Binding IsArchived}" Width="Auto" />
                            <DataGridTextColumn Header="Created"
                                                Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </TabItem>

        <TabItem Header="Extra actions">
            <Border Classes="fb-card"
                    Padding="16"
                    Margin="0,12,0,0">
                <Grid RowDefinitions="Auto, Auto, 48, *"
                      RowSpacing="12">
                    <TextBlock Grid.Row="0"
                               Text="GroupByName"
                               Classes="fb-section-title" />
                    <TextBlock Grid.Row="1"
                               Text="Extra operation from the UML model — groups todo lists by name."
                               Classes="fb-subtitle" />
                    <Grid Grid.Row="2"
                          ColumnDefinitions="Auto, Auto"
                          ColumnSpacing="12"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <CheckBox Grid.Column="0"
                                  Content="Include archived"
                                  IsChecked="{Binding IncludeArchived}" />
                        <Button Grid.Column="1"
                                Classes="AccentButton"
                                Content="Run"
                                Command="{Binding GroupByNameCommand}" />
                    </Grid>
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding GroupByNameResults}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              IsReadOnly="True"
                              MinHeight="400">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>
