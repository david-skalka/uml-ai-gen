<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:vm="using:TodoApp.ViewModels.TodoList"
             x:Class="TodoApp.Views.TodoList.TodoListPageView"
             x:Name="TodoListPage"
             x:DataType="vm:TodoListPageViewModel">

  <TabControl x:Name="MainTabControl"
              x:FieldModifier="public">
    <TabItem Header="CRUD">
      <Border Margin="0,12,0,0"
              Theme="{DynamicResource CardBorder}">
        <Grid RowDefinitions="Auto, *"
              RowSpacing="16">
          <u:ToolBar Grid.Row="0">
            <Button x:Name="NewButton"
                    x:FieldModifier="public"
                    u:ToolBar.OverflowMode="Never"
                    Classes="Primary"
                    Content="New"
                    Command="{Binding NewCommand}" />
            <Button x:Name="EditButton"
                    x:FieldModifier="public"
                    u:ToolBar.OverflowMode="AsNeeded"
                    Classes="Tertiary"
                    Content="Edit"
                    Command="{Binding EditCommand}" />
            <u:ToolBarSeparator />
            <Button x:Name="DeleteButton"
                    x:FieldModifier="public"
                    u:ToolBar.OverflowMode="AsNeeded"
                    Classes="Danger"
                    Content="Delete"
                    Command="{Binding DeleteCommand}" />
          </u:ToolBar>

          <DataGrid x:Name="TodoListsGrid"
                    x:FieldModifier="public"
                    Grid.Row="1"
                    ItemsSource="{Binding Items}"
                    SelectedItem="{Binding SelectedItem}"
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    IsReadOnly="True"
                    MinHeight="500">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
              <DataGridCheckBoxColumn Header="Archived" Binding="{Binding IsArchived}" Width="Auto" />
              <DataGridTextColumn Header="Created"
                                  Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                  Width="Auto" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </TabItem>

    <TabItem x:Name="GroupByNameTab"
             x:FieldModifier="public"
             Header="GroupByName">
      <Border Margin="0,12,0,0"
              Theme="{DynamicResource CardBorder}">
        <Grid RowDefinitions="Auto, *"
              RowSpacing="16">
          <u:ToolBar Grid.Row="0">
            <Button x:Name="GroupByNameRunButton"
                    x:FieldModifier="public"
                    u:ToolBar.OverflowMode="Never"
                    Classes="Primary"
                    Content="Run"
                    Command="{Binding GroupByNameCommand}" />
          </u:ToolBar>
          <DataGrid x:Name="GroupByNameResultsGrid"
                    x:FieldModifier="public"
                    Grid.Row="1"
                    ItemsSource="{Binding GroupByNameResults}"
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    IsReadOnly="True"
                    MinHeight="400">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="Auto" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </TabItem>
  </TabControl>
</UserControl>
