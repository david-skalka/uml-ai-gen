<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TodoApp.ViewModels.TodoList"
             x:Class="TodoApp.Views.TodoList.DialogGroupByNameView"
             x:DataType="vm:DialogGroupByNameViewModel"
             MinWidth="480"
             Background="Transparent">

  <Grid Margin="24"
        RowDefinitions="Auto, Auto, Auto, Auto"
        RowSpacing="16">
    <TextBlock Grid.Row="0"
               FontSize="16"
               FontWeight="SemiBold"
               Text="GroupByName" />

    <TextBlock Grid.Row="1"
               Opacity="0.65"
               Text="Extra operation from the UML model — groups todo lists by name."
               TextWrapping="Wrap" />

    <CheckBox x:Name="IncludeArchivedCheckBox"
              x:FieldModifier="public"
              Grid.Row="2"
              Content="Include archived"
              IsChecked="{Binding IncludeArchived}" />

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right">
      <Button Classes="Tertiary"
              Content="Cancel"
              Command="{Binding CancelCommand}" />
      <Button x:Name="RunButton"
              x:FieldModifier="public"
              Classes="Primary"
              Content="Run"
              Command="{Binding RunCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
