<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:vm="using:TodoApp.ViewModels.TodoList"
             x:Class="TodoApp.Views.TodoList.DialogGroupByNameView"
             x:DataType="vm:DialogGroupByNameViewModel"
             Background="Transparent"
             MinWidth="520">

  <Grid RowDefinitions="Auto, Auto, Auto, Auto"
        RowSpacing="16"
        Classes="Dialog">
    <shadui:CardTitle Grid.Row="0">GroupByName</shadui:CardTitle>

    <TextBlock Grid.Row="1"
               Classes="Muted"
               Text="Extra operation from the UML model — groups todo lists by name."
               TextWrapping="Wrap" />

    <CheckBox x:Name="IncludeArchivedCheckBox"
              x:FieldModifier="public"
              Grid.Row="2"
              Content="Include archived"
              IsChecked="{Binding IncludeArchived}" />

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                Spacing="12"
                HorizontalAlignment="Right">
      <Button Classes="Outline"
              Content="Cancel"
              Command="{Binding CancelCommand}" />
      <Button x:Name="RunButton"
              x:FieldModifier="public"
              Classes="Primary"
              Content="Run"
              Command="{Binding RunCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
