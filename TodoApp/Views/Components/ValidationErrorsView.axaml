<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="https://irihi.tech/ursa"
             x:Class="TodoApp.Views.Components.ValidationErrorsView"
             x:Name="Root">

  <u:FormItem Label="Validation errors"
              IsVisible="{Binding Text, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
    <TextBox Text="{Binding Text, ElementName=Root}"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             MinHeight="72"
             MaxHeight="160"
             Foreground="{DynamicResource TextBlockDangerForeground}"
             BorderBrush="{DynamicResource ButtonOutlineDangerBorderBrush}" />
  </u:FormItem>
</UserControl>
