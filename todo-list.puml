@startuml todo-list
title Todo List — API-Driven CRUD + Extra Actions


class TodoList <<Entity>> {
  +Id: int
  +Name: string
  +Description: string
  +IsArchived: bool
  +CreatedAt: DateTime
  --
  +GroupByName(input: GroupByNameInput): GroupByNameOutput[]
}

class Alarm <<Entity>> {
  +Id: int
  +Title: string
  +Time: DateTime
}

class GroupByNameInput <<Input>> {
  +IncludeArchived: bool
}

class GroupByNameOutput <<Output>> {
  +Name: string
  +Count: int
}

@enduml
